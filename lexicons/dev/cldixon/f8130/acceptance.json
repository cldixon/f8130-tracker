{
  "lexicon": 1,
  "id": "dev.cldixon.f8130.acceptance",
  "defs": {
    "main": {
      "type": "record",
      "description": "A receiving operator's signed verdict on a release certificate. Published in the operator's own repo, so it cannot be suppressed by the issuer. SYNTHETIC DEMONSTRATION DATA.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "issuerDid",
          "verifierDid",
          "partNumber",
          "serialNumber",
          "outcome",
          "receivedAt"
        ],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Strong reference to the release record being judged."
          },
          "issuerDid": {
            "type": "string",
            "format": "did",
            "description": "DID of the organization that issued the release under judgement."
          },
          "verifierDid": {
            "type": "string",
            "format": "did",
            "description": "DID of the operator publishing this verdict. Must match the repo this record lives in."
          },
          "partNumber": { "type": "string", "maxLength": 128 },
          "serialNumber": { "type": "string", "maxLength": 128 },
          "outcome": {
            "type": "string",
            "knownValues": ["accepted", "rejected", "discrepancy"]
          },
          "note": { "type": "string", "maxLength": 1000 },
          "receivedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
